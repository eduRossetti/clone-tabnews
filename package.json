{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação para treino do https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && node infra/scripts/prisma.js generate && npm run migrations:up && next dev",
    "build": "node infra/scripts/prisma.js generate && node infra/scripts/prisma.js migrate deploy && next build",
    "test": "npm run services:up && npm run services:wait:database && node infra/scripts/prisma.js generate && npm run migrations:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": " node infra/scripts/wait-for-postgres.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "migrations:create": "node infra/scripts/prisma.js migrate dev --name",
    "migrations:up": "node infra/scripts/prisma.js migrate deploy",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "async-retry": "1.3.3",
    "bcrypt": "6.0.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "next": "16.2.10",
    "next-connect": "1.0.0",
    "prisma": "6.19.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "2.4.2",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "concurrently": "10.0.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.4",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "prettier": "3.9.5",
    "set-cookie-parser": "^3.0.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
